          "id": "28911091-d660-4501-b9c4-7c3275e3f09e",
          "name": "Register a consumer click and receive a tracked destination URL",
          "request": {
            "name": "Register a consumer click and receive a tracked destination URL",
            "description": {
              "content": "Server-to-server click registration for CJ partners. Returns the final landing page URL carrying the `cjevent` tracking parameter; the partner is responsible for navigating the consumer to it, and for falling back to a traditional CJ tracking Click URL on any error. Cannot be called from a browser. CJ asks partners to contact their CJ representative for integration validation before implementing.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "partner",
                "event"
              ],
              "host": [
                "clicks",
                "api",
                "cj",
                "com"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"companyId\": \"<string>\",\n  \"adId\": \"<string>\",\n  \"promotionalPropertyId\": \"<string>\",\n  \"destinationUrl\": \"<string>\",\n  \"advertiserCompanyId\": \"<string>\",\n  \"clickParameters\": {\n    \"productCategory\": \"<string>\",\n    \"sid\": \"<string>\",\n    \"propertyName\": \"<string>\",\n    \"trafficSource\": \"<string>\"\n  },\n  \"userIpAddress\": \"<string>\",\n  \"userIdentifier\": \"<string>\",\n  \"userAgent\": \"<string>\",\n  \"referringUrl\": \"<string>\"\n}",
