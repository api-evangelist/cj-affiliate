      "name": "Publisher Lookup",
      "description": {
        "content": "Advertiser-side lookup of publishers joined to a program.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "35a77532-f56f-4306-b216-cf7fa611ef91",
          "name": "Look up publishers joined to your program",
          "request": {
            "name": "Look up publishers joined to your program",
            "description": {
              "content": "Advertiser-side lookup of the publishers in a program — program terms and join status, promotional methods, websites and PIDs, categories, EPC and network rating. Exactly one search criterion must be supplied alongside requestor-cid. The request URI must be encoded per HTML 4 form content encoding rules. Advertisers only. Documented call limit: 25 calls per minute.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v2",
                "joined-publisher-lookup"
              ],
              "host": [
                "publisher-lookup",
                "api",
                "cj",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "requestor-cid",
                  "value": "<string>",
                  "description": "(Required) CID of the company you are making the request for. You must be a member of that company."
                },
                {
                  "disabled": false,
                  "key": "date-accepted",
                  "value": "<string>",
                  "description": "Date the publisher accepted the program terms, YYYY-MM-DD."
                },
                {
                  "disabled": false,
                  "key": "publisher-name",
                  "value": "<string>",
                  "description": "Joined publisher's name. Must be more than 3 characters."
                },
                {
                  "disabled": false,
                  "key": "country",
                  "value": "<string>",
                  "description": "ISO 3166-1 alpha-2 country code of the publisher's location."
                },
                {
                  "disabled": false,
                  "key": "pid",
                  "value": "<string>",
                  "description": "The publisher's website ID (numeric, positive)."
                },
                {
                  "disabled": false,
                  "key": "cid",
                  "value": "<string>",
                  "description": "The publisher's company ID (numeric, positive)."
                },
                {
                  "disabled": false,
                  "key": "url",
                  "value": "<string>",
                  "description": "The publisher's website URL."
                },
                {
                  "disabled": false,
                  "key": "special-incentive",
                  "value": "<string>",
                  "description": "Whether the publisher runs an incentive / special program. Only the value `yes` (case-insensitive) is allowed."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
