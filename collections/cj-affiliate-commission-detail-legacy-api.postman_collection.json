                  "description": "Action status filter."
                },
                {
                  "disabled": false,
                  "key": "commission-id",
                  "value": "<string>",
                  "description": "Return everything newer than this Commission ID. The documented incremental-polling pattern: send the most recent Commission ID you received and CJ returns all new data since then."
