          "id": "48ae1f0d-3619-43f4-ba2d-f82407a1c386",
          "name": "Resolve a publisher click into a bounceless destination URL",
          "request": {
            "name": "Resolve a publisher click into a bounceless destination URL",
            "description": {
              "content": "Server-to-server click registration for publishers. Returns either a destination URL directly to the advertiser (when a bounceless journey is appropriate) or the original tracking link that was passed in. On any error the publisher must navigate the consumer to the traditional Click URL. Cannot be called from a browser — the browser-based equivalent is CJ's Publisher Tag.",
              "type": "text/plain"
            },
