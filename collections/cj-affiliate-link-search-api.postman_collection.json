{
  "item": [
    {
      "id": "009d9c6e-b4b1-4484-9d25-d20d7b3a4db4",
      "name": "Link Search",
      "description": {
        "content": "Publisher link discovery across the CJ network.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "a2821a55-8470-44d7-9e93-72756b28edc9",
          "name": "Search advertiser links",
          "request": {
            "name": "Search advertiser links",
            "description": {
              "content": "Find links across all advertisers in one call, filtered by keywords, category, link type, promotion type, relationship status, language, target country and more. All parameter names and values are case-insensitive. You must supply at least one optional parameter — an empty request returns zero results. Publishers only. Documented call limit: 25 calls per minute. The same endpoint serves the Automated Offer Feed for financial advertisers.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v2",
                "link-search"
              ],
              "host": [
                "link-search",
                "api",
                "cj",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "website-id",
                  "value": "<string>",
                  "description": "Your Website ID / Property ID (PID). Enables the system to generate the appropriate link code in the response. Must match the Website PID used to register for the developer key."
                },
                {
                  "disabled": false,
                  "key": "advertiser-ids",
                  "value": "<string>",
                  "description": "Comma-separated advertiser CIDs, or `joined`, or `notjoined`. An empty string currently behaves the same as `notjoined`."
                },
                {
                  "disabled": false,
                  "key": "keywords",
                  "value": "<string>",
                  "description": "Restricts results by keywords found in the link's advertiser name, link name, description and advertiser-tagged search keywords. Supports simple boolean operators `+` and `-`; default logic is OR."
                },
                {
                  "disabled": false,
                  "key": "category",
                  "value": "<string>",
                  "description": "Comma-separated advertiser SUB-category. Top-level/parent categories are not searchable. See the enumerations page."
                },
                {
                  "disabled": false,
                  "key": "link-type",
                  "value": "<string>",
                  "description": "Limits results to a specific link type. Product links are not available here — use the Product Search API. See the enumerations page."
                },
                {
                  "disabled": false,
                  "key": "promotion-type",
                  "value": "<string>",
                  "description": "Promotion type. Required if using promotion-start-date or promotion-end-date."
                },
                {
                  "disabled": false,
                  "key": "promotion-start-date",
                  "value": "<string>",
                  "description": "Promotion start date in MM/DD/YYYY format. Blank returns any start date."
                },
                {
                  "disabled": false,
                  "key": "promotion-end-date",
                  "value": "<string>",
                  "description": "Promotion end date in MM/DD/YYYY format, or the literal value `ongoing` for a promotion with no end date. Blank returns any end date."
                },
                {
                  "disabled": false,
                  "key": "page-number",
                  "value": "<integer>",
                  "description": "Page of the result set to view. Defaults to 1."
                },
                {
                  "disabled": false,
                  "key": "records-per-page",
                  "value": "<integer>",
                  "description": "Number of records per page. Defaults to 100 for this API."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Language the link was set at, using an accepted language code."
                },
                {
                  "disabled": false,
                  "key": "allow-deep-linking",
                  "value": "<string>",
                  "description": "Limit to links whose destination URL can be modified."
                },
                {
                  "disabled": false,
                  "key": "event-name",
                  "value": "<string>",
                  "description": "The event or occurrence the link relates to. One event at a time."
                },
                {
                  "disabled": false,
                  "key": "link-Id",
                  "value": "<string>",
                  "description": "The AdId / Link ID of an individual link. One at a time. Only active links are returned; invalid, deleted or archived links return 0 results."
                },
                {
                  "disabled": false,
                  "key": "last-updated",
                  "value": "<string>",
                  "description": "Return links updated since this date, inclusive. MM/DD/YYYY format."
                },
                {
                  "disabled": false,
                  "key": "cross-device-only",
                  "value": "<string>",
                  "description": "Limit to links supporting cross-device tracking."
                },
                {
                  "disabled": false,
                  "key": "mobile-app-download",
                  "value": "<string>",
                  "description": "Limit to links that direct the user to an App Store download."
                },
                {
                  "disabled": false,
                  "key": "mobile-optimized",
                  "value": "<string>",
                  "description": "Limit to links the advertiser flagged as mobile-optimized."
                },
                {
                  "disabled": false,
                  "key": "targeted-country",
                  "value": "<string>",
                  "description": "Two-letter country code, one at a time. Appears as `targeted-countries` in the response."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
          },
