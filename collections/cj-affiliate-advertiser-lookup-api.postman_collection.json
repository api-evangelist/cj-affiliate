      "item": [
        {
          "id": "452b375c-5abb-4021-b429-4f89f2e19129",
          "name": "Look up advertisers and their program details",
          "request": {
            "name": "Look up advertisers and their program details",
            "description": {
              "content": "Find advertisers in the CJ network by CID, program name or program URL, joined or not joined, with account status, EPC, categories, link types and default Program Term commission rates. Commission rates for Situations and Promotional Properties are NOT included — use the GraphQL Program Terms API for those. Publishers only. Documented call limit: 25 calls per minute.",
              "type": "text/plain"
            },
            "url": {
              "protocol": "https",
              "path": [
                "v2",
                "advertiser-lookup"
              ],
              "host": [
                "advertiser-lookup",
                "api",
                "cj",
                "com"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "requestor-cid",
                  "value": "<string>",
                  "description": "(Required) CID of the company you are making the request for. You must be a member of that company."
                },
                {
                  "disabled": false,
                  "key": "advertiser-ids",
                  "value": "<string>",
                  "description": "Comma-separated advertiser CIDs, or `joined`, or `notjoined`. An empty string currently behaves the same as `notjoined`."
                },
                {
                  "disabled": false,
                  "key": "advertiser-name",
                  "value": "<string>",
                  "description": "Advertiser program name, or program URL."
                },
                {
                  "disabled": false,
                  "key": "keywords",
                  "value": "<string>",
                  "description": "Keywords found in the advertiser's name, product name or product description. Supports `+` and `-`; default logic is OR."
                },
                {
                  "disabled": false,
                  "key": "page-number",
                  "value": "<integer>",
                  "description": "Page of the result set to view."
                },
                {
                  "disabled": false,
                  "key": "records-per-page",
                  "value": "25",
                  "description": "Records per page. Defaults to 25, maximum 100."
                },
                {
                  "disabled": false,
                  "key": "mobile-tracking-certified",
                  "value": "<string>",
                  "description": "Limit to advertisers certified (or not certified) for mobile tracking."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/xml"
              }
            ],
            "method": "GET",
            "auth": null
